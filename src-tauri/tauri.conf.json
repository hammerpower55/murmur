{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur",
  "version": "0.2.1",
  "identifier": "net.claritree.murmur",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 208,
        "height": 64,
        "visible": true,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Murmur contributors",
    "shortDescription": "Offline voice dictation for Windows on ARM64",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/onnxruntime-win-arm64-1.31.0/lib/onnxruntime.dll": "onnxruntime.dll",
      "vendor/onnxruntime-qnn-2.7.0/onnxruntime_providers_qnn.dll": "qnn/onnxruntime_providers_qnn.dll",
      "vendor/onnxruntime-qnn-2.7.0/QnnHtp.dll": "qnn/QnnHtp.dll",
      "vendor/onnxruntime-qnn-2.7.0/QnnHtpPrepare.dll": "qnn/QnnHtpPrepare.dll",
      "vendor/onnxruntime-qnn-2.7.0/QnnSystem.dll": "qnn/QnnSystem.dll",
      "vendor/onnxruntime-qnn-2.7.0/QnnHtpV73Stub.dll": "qnn/QnnHtpV73Stub.dll",
      "vendor/onnxruntime-qnn-2.7.0/libQnnHtpV73Skel.so": "qnn/libQnnHtpV73Skel.so",
      "vendor/onnxruntime-qnn-2.7.0/libqnnhtpv73.cat": "qnn/libqnnhtpv73.cat",
      "vendor/onnxruntime-qnn-2.7.0/LICENSE": "qnn/LICENSE",
      "vendor/onnxruntime-qnn-2.7.0/Qualcomm_LICENSE.pdf": "qnn/Qualcomm_LICENSE.pdf",
      "vendor/onnxruntime-qnn-2.7.0/ThirdPartyNotices.txt": "qnn/ThirdPartyNotices.txt",
      "vendor/onnxruntime-qnn-2.7.0/Privacy.md": "qnn/Privacy.md",
      "../NOTICE": "NOTICE",
      "../LICENSE": "LICENSE"
    }
  }
}
